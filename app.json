{
  "expo": {
    "name": "parking-photo-app",
    "slug": "parking-photo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkingphotoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép app chụp ảnh vị trí xe của bạn."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép app lưu vị trí xe để dẫn đường về."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép app truy cập ảnh.",
          "savePhotosPermission": "Cho phép app lưu ảnh bạn chọn giữ lại vào thư viện.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-notifications",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
