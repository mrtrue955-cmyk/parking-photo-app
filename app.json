{
  "expo": {
    "name": "Cột Xe",
    "slug": "parking-photo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkingphotoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.huutech.parkingphoto",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.huutech.parkingphoto",
      "adaptiveIcon": {
        "backgroundColor": "#F5A524",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép app chụp ảnh vị trí xe của bạn.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép app lưu vị trí xe để dẫn đường về.",
          "locationAlwaysAndWhenInUsePermission": "Cho phép app nhắc bạn khi rời bãi đỗ.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysPermission": "Cho phép app nhắc bạn khi rời bãi đỗ."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cho phép app truy cập ảnh.",
          "savePhotosPermission": "Cho phép app lưu ảnh bạn chọn giữ lại vào thư viện.",
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
