{
  "expo": {
    "name": "Cột Xe",
    "slug": "parking-photo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkingphotoapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.huutech.parkingphoto",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "GFCJMBQS45"
    },
    "android": {
      "package": "com.huutech.parkingphoto",
      "adaptiveIcon": {
        "backgroundColor": "#F5A524",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withPolicyManifest",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép app chụp ảnh vị trí xe của bạn.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép app lưu vị trí xe để dẫn đường về.",
          "locationAlwaysAndWhenInUsePermission": "Cho phép app nhắc bạn khi rời bãi đỗ.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysPermission": "Cho phép app nhắc bạn khi rời bãi đỗ.",
          "motionUsagePermission": false,
          "isAndroidMotionActivityEnabled": false,
          "locationFullAccuracyPermission": "Cho phép app dùng vị trí chính xác để dẫn bạn về đúng cột xe."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cho phép app lưu ảnh bạn chọn giữ lại vào thư viện.",
          "granularPermissions": []
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "expo-localization",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "ParkedSpot",
              "displayName": "Cột Xe",
              "description": "Vị trí đỗ xe và hạn tự xoá ảnh / your parked spot and photo expiry",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/parkedSpot.tsx"
              }
            }
          ]
        }
      ],
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
